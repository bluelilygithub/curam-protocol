PORT=3000
DATABASE_URL=postgresql://user:password@host:5432/railway

# ── Model resolution (see ../docs/theme-builder.md) ───────────────────────────
#
# Vault default_model + vault_models apply unless an app override below is set.
#
# Priority:
#   1. THEME_BUILDER_DESIGN_MODEL / THEME_BUILDER_STAGE1_MODEL (all envs)
#   2. THEME_BUILDER_DEV_DESIGN_MODEL (APP_ENV=local only)
#   3. Settings → Theme builder design model (workspace_settings)
#   4. Vault default_model → vault tiers → local Ollama fallback
#
# Local dev (recommended — set in vault/.env, not here, when using npm run dev):
# THEME_BUILDER_DEV_DESIGN_MODEL=ollama:qwen2.5-coder:14b
#
# Force any environment (overrides Settings + dev):
# THEME_BUILDER_DESIGN_MODEL=claude-sonnet-4-6
#
# CSS-only iterations (colour, spacing) — prefer local Ollama:
# THEME_BUILDER_CSS_ITERATE_MODEL=ollama:qwen2.5-coder:14b
# THEME_BUILDER_ITERATE_MODEL=ollama:qwen2.5-coder:14b
#
# Stage 2 WordPress theme ZIP:
# THEME_BUILDER_STAGE2_MODEL=ollama:qwen2.5-coder:14b
#
# Prompt builder (PRODUCTION ONLY — ignored when APP_ENV=local, so Qwen dev is
# unchanged). A cheap model rewrites the wizard brief into a sharper creative
# brief before the design model (Claude) generates. Mandatory nav/functionality/
# region-id blocks are preserved verbatim; failures fall back to the full brief.
# Defaults to the Vault `deepseek` tier when unset; set '' / omit to disable.
# THEME_BUILDER_PROMPT_MODEL=deepseek-chat
# THEME_BUILDER_PROMPT_MAX_TOKENS=3000
# THEME_BUILDER_DEEPSEEK_MAX_TOKENS=8000
#
# Lessons learnt → Vault Memory (shared DATABASE_URL):
# THEME_BUILDER_VAULT_USER_ID=1
