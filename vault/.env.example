# Copy this file to .env for local development. Never commit real .env values.

# ── Required ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Runtime mode ───────────────────────────────────────────────────────────────
# local uses LOCAL_DATABASE_URL when present; production uses DATABASE_URL.
APP_ENV=local

# ── Database ───────────────────────────────────────────────────────────────────
# Production/Railway connection string. Keep the real value in Railway variables.
DATABASE_URL=postgresql://prod_user:prod_password@prod_host:5432/vault

# Local Mac Mini connection string.
# The real local app data is expected to live in Docker container `local-pg`,
# exposed on localhost:5432. Do not replace it with an empty Homebrew Postgres DB.
# See docs/local-database-recovery.md before changing this.
LOCAL_DATABASE_URL=postgresql://vault_local:local_password@localhost:5432/vault

# ── WP Theme Builder (Stage 1 wireframe + design) ─────────────────────────────
# See docs/theme-builder.md for full model priority and dev vs production rules.
#
# Local dev: app override — Ollama (no paid API unless you set DESIGN_MODEL below)
THEME_BUILDER_DEV_DESIGN_MODEL=ollama:qwen2.5-coder:14b
#
# Optional: force a model in any environment (overrides admin UI + dev setting)
# THEME_BUILDER_DESIGN_MODEL=claude-sonnet-4-6
#
# Production: leave THEME_BUILDER_DEV_DESIGN_MODEL unset on Railway; use Vault
# Settings → Default model and/or Theme builder design model, plus API keys.
#
# CSS / style-only iterations prefer local Qwen when Ollama is running:
# THEME_BUILDER_CSS_ITERATE_MODEL=ollama:qwen2.5-coder:14b
# THEME_BUILDER_ITERATE_MODEL=ollama:qwen2.5-coder:14b
# THEME_BUILDER_VAULT_USER_ID=1

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development   # set to "production" on Railway (handled via railway.toml)

# ── Storage ───────────────────────────────────────────────────────────────────
# Local dev: relative paths work fine
DB_PATH=./data/vault.db
UPLOAD_DIR=./uploads

# Railway production: point both at your mounted Volume path, e.g.
#   DB_PATH=/data/vault.db
#   UPLOAD_DIR=/data/uploads
# Then mount the Volume at /data in the Railway dashboard.

# ── Google Gemini (optional — enables Gemini models in Multi-Model Debate) ────
# Get a key at https://aistudio.google.com/app/apikey
# You can also set this via Settings in the app UI
GEMINI_API_KEY=

# ── Web search (optional — enables @search in chat) ──────────────────────────
# Get a free API key at https://serpapi.com (100 free searches/month)
# You can also set this via Settings in the app UI
SEARCH_API_KEY=

# ── Product Scout (optional — Amazon comparison agent) ─────────────────────
# Rainforest API: https://www.rainforestapi.com/
RAINFOREST_API_KEY=
AMAZON_DOMAIN=amazon.com.au

# ── Email ─────────────────────────────────────────────────────────────────────
# Option A: MailChannels API (preferred — set MAIL_CHANNEL_API_KEY, or via Settings UI)
MAIL_CHANNEL_API_KEY=
MAIL_FROM=noreply@curam-ai.com.au

# Option B: SMTP via nodemailer (fallback if MAIL_CHANNEL_API_KEY not set)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password

# ── Password reset ─────────────────────────────────────────────────────────────
# Base URL used in reset email links (no trailing slash)
# Local: http://localhost:5173 | Railway: https://your-app.up.railway.app
APP_URL=http://localhost:5173

# ── Local model runtime ────────────────────────────────────────────────────────
# Useful when APP_ENV=local and models are served by Ollama on the Mac Mini.
MODEL_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_LOCAL_MODEL=qwen2.5-coder:14b

# ── Local image generation ─────────────────────────────────────────────────────
# ComfyUI local API for prompt-to-image testing on the Mac Mini.
IMAGE_PROVIDER=local-comfyui
LOCAL_IMAGE_API_URL=http://127.0.0.1:8188
LOCAL_IMAGE_MODEL=DreamShaper_8_pruned.safetensors

# Local image upscaling (ComfyUI). Put an ESRGAN/Real-ESRGAN model — e.g. Remacri,
# 4x-UltraSharp, 4x-NMKD-Siax — in ComfyUI/models/upscale_models, then name it here.
# LOCAL_UPSCALE_NATIVE is the model's native scale factor (most are 4); the app
# lanczos-rescales to hit the requested 2x/4x.
LOCAL_UPSCALE_MODEL=4x-UltraSharp.pth
LOCAL_UPSCALE_NATIVE=4

# Railway production image generation resolves the provider from the admin model
# record. Only the hosted provider API key is required in Railway.
FAL_API_KEY=

# Production image upscaling via Replicate (fidelity-first). Clarity Pro is the
# default; its `creativity` (-10..10) defaults to the strict/faithful end.
# Swap models freely (e.g. topazlabs/image-upscale, nightmareai/real-esrgan).
REPLICATE_API_TOKEN=
# REPLICATE_UPSCALE_MODEL=philz1337x/clarity-pro-upscaler
# Optional extra input params merged into the Replicate request (JSON), for
# model-specific knobs not covered by scale/creativity.
# REPLICATE_UPSCALE_INPUT={"output_format":"png"}

# Background removal (production). Local installs use the bundled @imgly model and
# need none of these. In production it calls a Replicate background-remover model.
# REPLICATE_BG_MODEL=851-labs/background-remover
# REPLICATE_BG_COST_USD=0.02

# Cost estimates shown in the UI and logged to the Usage dashboard.
# Clarity Pro bills per output megapixel ($0.03/MP, $0.03 min) — adjust if you
# switch models. FAL_IMAGE_COST_USD is the per-image estimate for generation.
# REPLICATE_UPSCALE_RATE_PER_MP=0.03
# REPLICATE_UPSCALE_MIN_USD=0.03
# FAL_IMAGE_COST_USD=0.025

# ── Media, market data, and object storage ────────────────────────────────────
# YouTube API key enables YouTube search.
YOUTUBE_API_KEY=

# Finnhub enables US share quotes and company news.
FINNHUB_API_KEY=

# Portfolio observation agent — ETF proxies for market context (free quote APIs
# don't cover raw indices). Defaults shown; override only if you prefer others.
# Nasdaq → QQQ, SOX (semis) → SOXX (both via Finnhub); ASX 200 → STW (Alpha Vantage).
# OBS_INDEX_NASDAQ=QQQ
# OBS_INDEX_SOX=SOXX
# OBS_INDEX_ASX=STW

# Gold spot cache duration in milliseconds. 86400000 = 24 hours.
GOLD_CACHE_MS=86400000

# Optional S3-compatible object storage.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_REGION=

# ── Local safety flags ─────────────────────────────────────────────────────────
# Set to true locally if you do not want the Mac Mini instance calling external services.
DISABLE_EMAIL=true
DISABLE_EXTERNAL_CRON=true
DISABLE_WEB_SEARCH=true

# ── Gmail integration (optional — enables @gmail in chat) ─────────────────────
# 1. Go to https://console.cloud.google.com/ → APIs & Services → Credentials
# 2. Create OAuth 2.0 Client ID (Web application type)
# 3. Add your Railway URL + /api/gmail/callback as an Authorized redirect URI
#    e.g. https://curam-vault.up.railway.app/api/gmail/callback
# 4. Enable the Gmail API in APIs & Services → Library
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-app.up.railway.app/api/gmail/callback

# ── Gmail token encryption (recommended in production) ────────────────────────
# Encrypts OAuth access and refresh tokens at rest using AES-256-GCM.
# Generate a key with: openssl rand -hex 32
# If absent, tokens are stored in plaintext (a warning is logged on startup).
ENCRYPTION_KEY=
