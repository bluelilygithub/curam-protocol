# ── Amazon product data (Rainforest API) ─────────────────────────────────────
# Sign up: https://www.rainforestapi.com/
RAINFOREST_API_KEY=

# Amazon marketplace (amazon.com, amazon.com.au, amazon.co.uk, …)
AMAZON_DOMAIN=amazon.com

# ── LLM (comparison scoring) ─────────────────────────────────────────────────
# Provider: anthropic | openai | openai_compatible
LLM_PROVIDER=anthropic

# Model id — e.g. claude-sonnet-4-20250514, gpt-4o, or your local model name
LLM_MODEL=claude-sonnet-4-20250514

# Anthropic (when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=

# OpenAI or compatible endpoint (when LLM_PROVIDER=openai or openai_compatible)
OPENAI_API_KEY=
# Optional base URL for local LM Studio, Ollama OpenAI shim, etc.
OPENAI_BASE_URL=

# ── Cross-market web search ──────────────────────────────────────────────────
# Same keys as Vault — one of Brave, Serper, or SerpAPI
SEARCH_API_KEY=
# Optional: brave | serper | serpapi (auto-detected from key shape if omitted)
SEARCH_PROVIDER=
