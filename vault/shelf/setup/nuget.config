<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- a fresh .NET SDK install has no package source; this project takes its packages from nuget.org only -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
