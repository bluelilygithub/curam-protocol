<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tests for the Windows shell. They use the REAL Windows pieces (DPAPI, Credential Manager, the registry, the clipboard), not stand-ins. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>VaultShelf.Host.Tests</RootNamespace>
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <!-- the installer's own unpacking, folder rule and runtime check are tested here (it is a separate program, so its files are compiled in) -->
  <ItemGroup>
    <Compile Include="..\setup\VaultShelf.Setup\SafeZip.cs" Link="Setup\SafeZip.cs" />
    <Compile Include="..\setup\VaultShelf.Setup\InstallFolder.cs" Link="Setup\InstallFolder.cs" />
    <Compile Include="..\setup\VaultShelf.Setup\WebView2Runtime.cs" Link="Setup\WebView2Runtime.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\host\VaultShelf.Host.csproj" />
  </ItemGroup>

</Project>
