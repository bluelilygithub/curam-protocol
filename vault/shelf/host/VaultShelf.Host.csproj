<Project Sdk="Microsoft.NET.Sdk">

  <!-- Vault Shelf, the Windows shell (M2): tray icon, global hotkey, clipboard, and the on-demand WebView2 window that shows ../dist. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>VaultShelf</AssemblyName>
    <RootNamespace>VaultShelf.Host</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- memory: no ICU data, no background GC thread, no profile-guided tiering (each costs resident memory in a process meant to sit idle) -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="VaultShelf.Host.Tests" />
  </ItemGroup>

  <!--
    Publishing (see README, "Make an installable copy"): a self-contained build needs no .NET on the PC, so a double-click just works. The built page (../dist) is copied
    next to the program as the "shelf" folder, where the program looks for it. Run `npm run build` in vault/shelf first.
  -->
  <Target Name="CopyShelfPage" AfterTargets="Publish">
    <ItemGroup>
      <ShelfPageFiles Include="$(MSBuildProjectDirectory)\..\dist\**\*" />
    </ItemGroup>
    <Error Condition="'@(ShelfPageFiles)' == ''" Text="The shelf page is not built. Run 'npm run build' in vault/shelf first." />
    <Copy SourceFiles="@(ShelfPageFiles)" DestinationFiles="@(ShelfPageFiles->'$(PublishDir)shelf\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>

</Project>
