{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": { "@planner-core/*": ["../planner-core/src/*"], "zustand/*": ["./node_modules/zustand/*"] }
  },
  "include": ["src", "tests", "vitest.config.ts", "../planner-core/src/engine/history.ts", "../planner-core/src/library"]
}
