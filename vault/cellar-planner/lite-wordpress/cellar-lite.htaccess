# Cellar Planner lite: caching rules for this folder (the upload zip puts this file in as ".htaccess").
#
# The page itself (index.html) must never be kept for long. If it is, a new upload is not seen for weeks or months, because the old page keeps asking
# for old files that no longer exist (404). The other files have a fingerprint in their name (lite-AbC123.js), so a changed file always has a new
# name and they can safely be kept for a year.
<IfModule mod_headers.c>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # the help chat script keeps the same name from one upload to the next, so it must not be kept for long either
  <FilesMatch "^cellar-lite-guide\.js$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # Only the website itself may show the planner in a frame (www and non-www are different origins to the browser, so both are listed).
  # Another site framing it could lay its own page over the quote form. If the domain changes, change both names here.
  <FilesMatch "^index\.html$">
    Header set Content-Security-Policy "frame-ancestors 'self' https://wiwc.com.au https://www.wiwc.com.au"
  </FilesMatch>
  Header set X-Content-Type-Options "nosniff"
</IfModule>
