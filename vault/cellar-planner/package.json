{
  "name": "cellar-planner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Walk-in wine cellar configurator. Milestone 1: the pure rule and maths engine (no UI).",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "dev": "vite",
    "build": "vite build",
    "e2e": "node scripts/e2e.mjs",
    "e2e:lite-site": "node scripts/e2e-lite-ux.mjs && node scripts/e2e-lite-config.mjs && node scripts/e2e-lite-contact.mjs",
    "example": "vite-node scripts/writeExample.mjs",
    "dev:lite": "vite --config vite.lite.config.ts",
    "build:lite": "vite build --config vite.lite.config.ts",
    "zip:lite": "vite build --config vite.lite.config.ts && node scripts/zipLite.mjs",
    "build:lite:vault": "vite build --config vite.lite.config.ts --outDir ../dist/cellar-lite"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "axe-core": "^4.14.0",
    "fast-check": "^4.1.1",
    "playwright-core": "^1.63.0",
    "typescript": "^5.8.3",
    "vite": "^7.3.7",
    "vite-node": "^6.0.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "konva": "^10.7.1",
    "pdf-lib": "1.17.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shepherd.js": "^14.5.0",
    "zustand": "^5.0.15"
  }
}
