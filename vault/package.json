    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "express-rate-limit": "^7.2.0",
    "googleapis": "^144.0.0",
    "helmet": "^7.1.0",
    "imagetracerjs": "^1.2.6",
    "mammoth": "^1.8.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.13",
    "pdf-lib": "^1.17.1",
