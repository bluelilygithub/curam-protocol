{
  "name": "project-vault",
  "version": "1.0.0",
  "description": "AI-powered project workspace",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "nodemon --config nodemon.json server/index.js",
    "dev:client": "vite --config client/vite.config.js",
    "build": "vite build --config client/vite.config.js",
    "start": "node server/index.js",
    "migrate:embeddings": "node server/scripts/migrateEmbeddings.js"
  },
