{
  "name": "project-vault",
  "version": "1.0.0",
  "description": "AI-powered project workspace",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "nodemon --config nodemon.json server/index.js",
    "dev:client": "vite --config client/vite.config.js",
    "build": "vite build --config client/vite.config.js",
    "start": "node server/index.js",
    "migrate:embeddings": "node server/scripts/migrateEmbeddings.js",
    "test:document-redaction-m1": "node server/services/documentRedaction/milestone1.test.js",
    "test:document-redaction-m3": "node server/services/documentRedaction/milestone3.test.js",
    "test:document-redaction-m4": "node server/services/documentRedaction/milestone4.test.js",
    "test:document-redaction-m5": "node server/services/documentRedaction/milestone5.test.js",
    "test:document-redaction-m6": "node server/services/documentRedaction/milestone6.test.js",
    "test:property-scenario": "node server/services/propertyScenario/scenario.test.js",
    "test:property-scenario-parse": "node server/services/propertyScenario/parseScenario.test.js",
    "test:property-scenario-grounding": "node server/services/propertyScenario/grounding.test.js",
    "test:property-scenario-spans": "node server/services/propertyScenario/extractSpans.test.js",
    "test:property-scenario-case3": "node server/services/propertyScenario/grounding.test.js --live",
    "test:property-scenario-calc": "node server/services/propertyScenario/calc/calc.test.js",
    "test:property-scenario-standalone": "node server/services/propertyScenario/calc/standalone.test.js",
    "test:property-scenario-bridging": "node server/services/propertyScenario/calc/bridgingCost.test.js",
    "test:property-scenario-orchestrate": "node server/services/propertyScenario/orchestrate.test.js",
    "test:property-scenario-e2e": "node server/services/propertyScenario/orchestrate.test.js --e2e",
    "test:property-scenario-presentation": "node server/services/propertyScenario/presentation.test.js",
    "test:property-scenario-cdr": "node server/services/propertyScenario/cdr/normalize.test.js",
    "test:property-scenario-cdr-live": "node server/services/propertyScenario/cdr/live.probe.js",
    "test:property-scenario-wire": "node server/services/propertyScenario/wireApi.test.js",
    "test:property-scenario-insights": "node server/services/propertyScenario/insights/insights.test.js",
    "test:property-scenario-insights-live": "node server/services/propertyScenario/insights/live.probe.js"
