    "rss-parser": "^3.13.0",
    "sharp": "^0.32.6",
    "sql.js": "^1.14.1",
    "tesseract.js": "^7.0.0",
    "uuid": "^11.1.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.12",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "lucide-react": "^0.363.0",
    "nodemon": "^3.1.0",
    "postcss": "^8.4.38",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^6.22.3",
