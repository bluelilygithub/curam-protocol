    "archiver": "^7.0.1",
    "bcryptjs": "^2.4.3",
    "chrono-node": "^2.10.0",
    "dompurify": "^3.4.11",
    "dotenv": "^16.4.5",
    "exif-reader": "^2.0.3",
    "express": "^4.18.3",
    "express-rate-limit": "^7.2.0",
    "gifenc": "^1.0.3",
    "googleapis": "^173.0.0",
    "helmet": "^7.1.0",
    "imagetracerjs": "^1.2.6",
    "jsdom": "^29.1.1",
    "mammoth": "^1.8.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.5.0",
    "nodemailer": "^9.0.1",
    "pdf-lib": "^1.17.1",
