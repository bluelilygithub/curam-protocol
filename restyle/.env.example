# Required for the plain-English AI editor (Anthropic Claude).
ANTHROPIC_API_KEY=

# Optional: same Postgres connection string as the Curam Vault app. When set, Restyle reads
# the "standard" model id from Vault's own settings (vault_models/default_model, first admin)
# instead of falling back to a hardcoded model. Restyle never writes to this database.
DATABASE_URL=

# Optional, defaults to 3000 locally. Railway sets this automatically — don't hardcode it.
PORT=3000
